rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      // User can read only their own profile
      allow read: if isOwner(userId);

      // User can create only their own profile, but cannot set secure fields
      allow create: if isOwner(userId)
                    && !request.resource.data.keys().hasAny(['role', 'status', 'isEmailVerified']);

      // User can update only their own profile, but cannot change secure fields
      allow update: if isOwner(userId)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'isEmailVerified']));

      // User can delete only their own profile
      allow delete: if isOwner(userId);

      // ==========================================================
      // CART ITEMS
      // ==========================================================

      match /cartItems/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ============================================================
    // PRODUCTS
    // ============================================================

    match /products/{productId} {

      // Product catalog is publicly readable
      allow read: if true;

      // Seller can create only a product belonging to themselves
      allow create: if isAuthenticated()
        && request.resource.data.sellerId == request.auth.uid;

      // Seller can update only their own product
      allow update: if isAuthenticated()
        && resource.data.sellerId == request.auth.uid;

      // Seller can delete only their own product
      allow delete: if isAuthenticated()
        && resource.data.sellerId == request.auth.uid;
    }

    // ============================================================
    // CUSTOMER ORDERS
    // ============================================================

    match /customerOrders/{orderId} {

      // Buyer can read their own orders
      allow read: if isAuthenticated()
        && resource.data.buyerId == request.auth.uid;

      // Orders must be created via Cloud Functions
      allow create: if false;

      // Orders cannot be modified/deleted by the client
      allow update, delete: if false;
    }

    // ============================================================
    // SELLER ORDERS
    // ============================================================

    match /sellerOrders/{orderId} {

      // Seller can read orders assigned to them.
      // Buyer can also read their own order.
      allow read: if isAuthenticated()
        && (
          resource.data.sellerId == request.auth.uid
          || resource.data.buyerId == request.auth.uid
        );

      // Orders must be created via Cloud Functions
      allow create: if false;

      // Seller can update orders assigned to them (restricted to status only)
      allow update: if isAuthenticated()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);

      // Client cannot delete orders
      allow delete: if false;
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}