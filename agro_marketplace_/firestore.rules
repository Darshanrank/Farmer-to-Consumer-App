rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Function to check if user owns the document
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function validSellerOrderTransition() {
      return
        (resource.data.status == 'pending' &&
          request.resource.data.status in ['accepted', 'rejected', 'cancelled']) ||
        (resource.data.status == 'accepted' &&
          request.resource.data.status in ['preparing', 'cancelled']) ||
        (resource.data.status == 'preparing' &&
          request.resource.data.status in ['packed', 'cancelled']) ||
        (resource.data.status == 'packed' &&
          request.resource.data.status == 'ready') ||
        (resource.data.status == 'ready' &&
          request.resource.data.status == 'dispatched') ||
        (resource.data.status == 'dispatched' &&
          request.resource.data.status == 'delivered');
    }

    function validDeliveryStageTransition() {
      return
        (!resource.data.keys().hasAny(['deliveryStage']) &&
          request.resource.data.deliveryStage in ['assigned', 'failed']) ||
        (resource.data.deliveryStage == 'assigned' &&
          request.resource.data.deliveryStage in ['picked_up', 'failed']) ||
        (resource.data.deliveryStage == 'picked_up' &&
          request.resource.data.deliveryStage in ['in_transit', 'failed']) ||
        (resource.data.deliveryStage == 'in_transit' &&
          request.resource.data.deliveryStage in ['delivered', 'failed']) ||
        (resource.data.deliveryStage == 'failed' &&
          request.resource.data.deliveryStage == 'returned');
    }

    // USERS COLLECTION
    // Users can create their own doc (on registration) and read/update it.
    // Role and status fields are protected — cannot be changed via client update.
    match /users/{userId} {
      // Allow full read of own document
      allow read: if isOwner(userId);
      
      // Allow create (registration) — the app sets role here once
      allow create: if isOwner(userId);
      
      // Role is assigned at registration and cannot be changed by the client.
      allow update: if isOwner(userId)
                    && (!request.resource.data.keys().hasAny(['role'])
                        || request.resource.data.role == resource.data.role)
                    && (!request.resource.data.keys().hasAny(['status'])
                        || request.resource.data.status == resource.data.status);
      
      // CART ITEMS SUBCOLLECTION
      match /cartItems/{itemId} {
        allow read, write: if isOwner(userId);
      }

      // Notifications are private, user-scoped application data. Business
      // events may also be recorded by the authenticated owner after a
      // successful client operation when Functions are unavailable.
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'title', 'message', 'type', 'isRead', 'createdAt',
            'entityId', 'entityType'
          ])
          && request.resource.data.title is string
          && request.resource.data.message is string
          && request.resource.data.type is string
          && request.resource.data.isRead == false
          && request.resource.data.createdAt is timestamp;
        allow delete: if false;
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isRead'])
          && request.resource.data.isRead is bool;
      }

    }
    
    // PRODUCTS COLLECTION
    // Anyone (even unauthenticated) can read active products. 
    // Only the seller who owns the product can write/update/delete it.
    match /products/{productId} {
      allow read: if true; 
      allow create: if isAuth() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAuth()
                    && resource.data.sellerId == request.auth.uid
                    && request.resource.data.sellerId == resource.data.sellerId
                    && request.resource.data.stockQuantity is int
                    && request.resource.data.reservedQuantity is int
                    && request.resource.data.soldQuantity is int
                    && request.resource.data.stockQuantity >= 0
                    && request.resource.data.reservedQuantity >= 0
                    && request.resource.data.soldQuantity >= 0
                    && request.resource.data.stockQuantity >=
                       request.resource.data.reservedQuantity +
                       request.resource.data.soldQuantity;
      allow delete: if isAuth() && resource.data.sellerId == request.auth.uid;
    }
    
    // CUSTOMER ORDERS (Buyer View)
    // Only the buyer who placed the order can read it.
    // Allow creation if the buyerId matches the authenticated user.
    match /customerOrders/{orderId} {
      allow read: if isAuth() && resource.data.buyerId == request.auth.uid;
      allow create: if isAuth()
                    && request.resource.data.buyerId == request.auth.uid
                    && !request.resource.data.keys().hasAny(['schemaVersion']);
      allow update: if isAuth()
                    && !resource.data.keys().hasAny(['schemaVersion'])
                    && request.auth.uid in resource.data.sellerIds
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'updatedAt'])
                    && request.resource.data.status in
                       ['pending', 'processing', 'partially_fulfilled', 'delivered', 'cancelled'];
    }
    
    // SELLER ORDERS (Seller View)
    // Sellers can read orders assigned to them.
    // Buyers can read orders they placed (to track package status).
    // Allow creation if the buyerId matches the authenticated user.
    match /sellerOrders/{orderId} {
      allow read: if isAuth() && (resource.data.sellerId == request.auth.uid || resource.data.buyerId == request.auth.uid);
      allow create: if isAuth()
                    && request.resource.data.buyerId == request.auth.uid
                    && !request.resource.data.keys().hasAny(['schemaVersion']);
      allow update: if isAuth()
                    && !resource.data.keys().hasAny(['schemaVersion'])
                    && resource.data.sellerId == request.auth.uid
                    && (
                      (
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'updatedAt'])
                        && validSellerOrderTransition()
                      ) ||
                      (
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['transportAssignment', 'deliveryStage', 'updatedAt'])
                        && request.resource.data.deliveryStage == 'assigned'
                        && resource.data.status in ['accepted', 'preparing', 'packed', 'ready']
                      ) ||
                      (
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['deliveryStage', 'updatedAt'])
                        && validDeliveryStageTransition()
                      ) ||
                      (
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['deliveryStage', 'fulfilmentStatus', 'status', 'deliveredAt', 'updatedAt'])
                        && request.resource.data.deliveryStage == 'delivered'
                        && request.resource.data.fulfilmentStatus == 'delivered'
                        && request.resource.data.status == 'delivered'
                        && validDeliveryStageTransition()
                      )
                    );
    }

    // SUPPORT REQUESTS
    // Authenticated users can create support requests.
    // No client reads — handled server side.
    match /supportRequests/{requestId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read: if false; // admin-only
      allow update, delete: if false;
    }

    // Trusted commerce collections. Client writes are denied; the Admin SDK
    // used by Cloud Functions bypasses these client rules.
    match /checkoutRequests/{requestId} {
      allow read, write: if false;
    }

    match /inventoryReservations/{reservationId} {
      allow read, write: if false;
    }

    match /orderEvents/{eventId} {
      allow read, write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if isAuth();
      allow write: if false;
    }

    match /paymentEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
