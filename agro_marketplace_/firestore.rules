rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Function to check if user owns the document
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // USERS COLLECTION
    // Users can create their own doc (on registration) and read/update it.
    // Role and status fields are protected — cannot be changed via client update.
    match /users/{userId} {
      // Allow full read of own document
      allow read: if isOwner(userId);
      
      // Allow create (registration) — the app sets role here once
      allow create: if isOwner(userId);
      
      // Allow update: user can update profile and switch role between buyer and seller
      allow update: if isOwner(userId)
                    && (!request.resource.data.keys().hasAny(['role']) 
                        || request.resource.data.role in ['buyer', 'seller'])
                    && (!request.resource.data.keys().hasAny(['status'])
                        || request.resource.data.status == resource.data.status);
      
      // CART ITEMS SUBCOLLECTION
      match /cartItems/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // PRODUCTS COLLECTION
    // Anyone (even unauthenticated) can read active products. 
    // Only the seller who owns the product can write/update/delete it.
    match /products/{productId} {
      allow read: if true; 
      allow create: if isAuth() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.sellerId == request.auth.uid;
    }
    
    // CUSTOMER ORDERS (Buyer View)
    // Only the buyer who placed the order can read it.
    // Allow creation if the buyerId matches the authenticated user.
    match /customerOrders/{orderId} {
      allow read: if isAuth() && resource.data.buyerId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.buyerId == request.auth.uid;
    }
    
    // SELLER ORDERS (Seller View)
    // Sellers can read orders assigned to them.
    // Buyers can read orders they placed (to track package status).
    // Allow creation if the buyerId matches the authenticated user.
    match /sellerOrders/{orderId} {
      allow read: if isAuth() && (resource.data.sellerId == request.auth.uid || resource.data.buyerId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAuth() && resource.data.sellerId == request.auth.uid; // Sellers can update status
    }

    // SUPPORT REQUESTS
    // Authenticated users can create support requests.
    // No client reads — handled server side.
    match /supportRequests/{requestId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read: if false; // admin-only
      allow update, delete: if false;
    }
  }
}
